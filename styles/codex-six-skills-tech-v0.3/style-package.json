  "source_limit": "单条参考视频候选。不能证明同创作者跨视频稳定风格；不得复用原作者的镜头或素材。 此V0.2修正了样段蓝色舞台被全片误用的问题。 V0.3只新增P04可触发规则和动效执行桥，其余V0.2默认不变。",
  "visual_skin": {
    "status": "interpreted_not_measured",
    "description": "背景和材质由参考事件及画面任务逐镜选择；深蓝只是候选之一。保留真人原景、浅暖图解、真实界面主画面、透明叠层与深色舞台的合理切换。",
    "background": [
      "#0C1331",
      "#161D48",
      "#F6F1E8",
      "#F7F8FF"
    ],
    "foreground": "#F7F8FF",
    "accents": [
      "#66E3F2",
      "#8A79F7",
      "#F4D966"
    ],
    "rules": [
      "真实软件画面承载功能演示，不用无关卡片代替",
      "人物缩小只为让主要媒体变得可读；优先保护字幕安全区",
      "标题、结论、媒体各有不同层级；小字网格不能堆满画面",
      "真实录屏、人物、图解与结果大字交替，但不得为丰富而堆特效",
      "深蓝不等于科技感；每个镜头明确背景模式并说明参考来源，参考事件有浅色或实景时不能只继承全局深蓝",
      "禁止项目CSS !important 将浅色软件界面或模板默认白底统一改深蓝，除非逐镜审批有源事件证据",
      "与口播相关的工具/生成结果必须提供真实媒体或明确标记纯示意；缺真实素材不能把原本 required 静默改成 none"
    ],
    "background_mode_policy": {
      "presenter_natural": "真实口播镜头的原有空间/肤色，不套蓝色半透明遮罩，只允许局部标题、局部标签。",
      "dark_tech": "确实需要抽象科技舞台时允许局部深蓝；不能默认套在所有包装上，也不能用蓝色媒体嵌蓝色舞台来掩饰空内容。",
      "light_explainer": "浅暖米白与对比强烈的图文/插画；参考 P08 e026/e052，禁止强制覆盖公共组件浅底。",
      "media_first": "真实软件界面、截图、实际结果优先作为视觉主画面。其原始亮/暗表面不应被统一蓝色CSS覆盖。",
      "transparent_overlay": "在真实人物镜头上以透明动效叠加结果或章节，不增加全屏蓝舞台。"
    }
  },
