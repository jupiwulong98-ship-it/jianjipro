  "visual_skin": {
    "status": "interpreted_not_measured",
    "description": "深蓝紫主舞台、浅色媒体层、蓝青色强调、醒目章节编号；真人、软件画面、动画图解交替",
    "background": [
      "#0C1331",
      "#161D48"
    ],
    "foreground": "#F7F8FF",
    "accents": [
      "#66E3F2",
      "#8A79F7",
      "#F4D966"
    ],
    "rules": [
      "真实软件画面承载功能演示，不用无关卡片代替",
      "人物缩小只为让主要媒体变得可读；优先保护字幕安全区",
      "标题、结论、媒体各有不同层级；小字网格不能堆满画面",
      "真实录屏、人物、图解与结果大字交替，但不得为丰富而堆特效"
    ]
  },
  "motion_grammar": {
    "status": "candidate_not_precisely_measured",
    "layers": [
      "presenter",
      "media_container",
      "internal_media_motion",
      "takeaway",
      "captions",
      "chapter_navigation"
    ],
    "rules": [
      "进入窗口、窗口内部演示、退出转场分层制作",
      "入场和变化锚定新口播的逐词时点，不复制参考原视频秒数",
      "结果强强调需要先大字入场、稳定可读，再退出",
      "先做8-12秒完整动态样段，用户满意后再整片制作"
    ]
  },
