{
  "name": "jianjipro-motion-library",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "talkcraft:list": "node runtime-talkcraft/render.mjs list",
    "talkcraft:resolve": "node runtime-talkcraft/render.mjs resolve",
    "talkcraft:render": "node runtime-talkcraft/render.mjs render",
    "talkcraft:index": "node scripts/index-talkcraft.mjs",
    "test:talkcraft": "node --test tests/talkcraft.test.mjs",
    "validate": "npm run talkcraft:index && npm run test:talkcraft"
  },
  "dependencies": {
    "@remotion/player": "4.0.522",
    "@vitejs/plugin-react": "^6.0.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "remotion": "4.0.522",
    "vite": "^8.1.4",
    "vitest": "^4.0.18",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "jsdom": "^27.0.0",
    "typescript": "~6.0.2"
  }
}
