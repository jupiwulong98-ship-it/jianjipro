      "languageCode": null,
      "layout": {},
      "start": 36133333,
      "style": {},
      "text": "很多开发者会把自己做的 AI 工具、",
      "trackId": "cae2256e-b7e1-4b0a-9a8b-6e306ded47b0"
    },
    {
      "end": 39746667,
      "id": "36:9b1a0337-10ca-41ee-ab22-28527c1d676136:595ddc49-9777-479d-b080-4162503ce1154a75bc05-eab2-4f56-b57b-c6a1b74dd348",
      "languageCode": null,
      "layout": {},
      "start": 38866667,
      "style": {},
      "text": "开源项目、",
      "trackId": "cae2256e-b7e1-4b0a-9a8b-6e306ded47b0"
    },
    {
      "end": 40566667,
      "id": "36:9b1a0337-10ca-41ee-ab22-28527c1d676136:595ddc49-9777-479d-b080-4162503ce1151a6d5623-f6c2-44c5-99c1-607aeeaafb06",
      "languageCode": null,
      "layout": {},
      "start": 39786667,
      "style": {},
      "text": "学习资料",
      "trackId": "cae2256e-b7e1-4b0a-9a8b-6e306ded47b0"
    },
