      "languageCode": null,
      "layout": {},
      "start": 52800000,
      "style": {},
      "text": "没有账号的话点击右上角的 Sign up",
      "trackId": "cae2256e-b7e1-4b0a-9a8b-6e306ded47b0"
    },
