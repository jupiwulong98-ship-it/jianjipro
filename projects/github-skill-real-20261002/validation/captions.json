{
  "captionsItemId": "9b1a0337-10ca-41ee-ab22-28527c1d6761",
  "cards": [
    {
      "end": 3210000,
      "id": "36:9b1a0337-10ca-41ee-ab22-28527c1d676136:116f4125-18ac-49c7-b0b9-52a3170f27e171fd2ed4-9dc6-414c-83db-322f9a4eef6c",
      "languageCode": null,
      "layout": {},
      "start": 250000,
      "style": {},
      "text": "我之前分享的 Codex Skill 的那条视频，",
      "trackId": "cae2256e-b7e1-4b0a-9a8b-6e306ded47b0"
    },
    {
      "end": 4810000,
      "id": "36:9b1a0337-10ca-41ee-ab22-28527c1d676136:116f4125-18ac-49c7-b0b9-52a3170f27e1c21afc3b-5ba5-44a5-a353-15c0dbea4664",
      "languageCode": null,
      "layout": {},
      "start": 3210000,
      "style": {},
      "text": "已经有十多万人看过了。",
      "trackId": "cae2256e-b7e1-4b0a-9a8b-6e306ded47b0"
    },
    {
      "end": 7706667,
      "id": "36:9b1a0337-10ca-41ee-ab22-28527c1d676136:8a11ab27-99ee-44f8-b54e-37a84c5f040e26c47323-d2db-43d5-9184-408c8012547e",
      "languageCode": null,
      "layout": {},
      "start": 5066667,
      "style": {},
      "text": "但其实那几个 Skill 都不是我私藏的。",
      "trackId": "cae2256e-b7e1-4b0a-9a8b-6e306ded47b0"
    },
    {
      "end": 10646667,
      "id": "36:9b1a0337-10ca-41ee-ab22-28527c1d676136:161a8f8e-b2e0-4dfa-be0c-7b32e6c3dab5a884f4ab-918b-4926-9a7b-829e5c1233e1",
      "languageCode": null,
      "layout": {},
      "start": 7966667,
      "style": {},
      "text": "它们基本上都能够在 GitHub 上面找到。",
      "trackId": "cae2256e-b7e1-4b0a-9a8b-6e306ded47b0"
    },
    {
      "end": 13266667,
      "id": "36:9b1a0337-10ca-41ee-ab22-28527c1d676136:2964ceaf-a214-41eb-93c9-01323f790387317aaeeb-003f-4abd-9593-12045849e1fb",
      "languageCode": null,
      "layout": {},
      "start": 10866667,
      "style": {},
      "text": "所以这期我不继续给你推荐 Skill 了。",
      "trackId": "cae2256e-b7e1-4b0a-9a8b-6e306ded47b0"
    },
    {
      "end": 15533333,
      "id": "36:9b1a0337-10ca-41ee-ab22-28527c1d676136:6bc3a9dc-e498-469e-bdfd-218086de5087b5da5e53-c185-4bef-b9e3-413e09a1d0fd",
      "languageCode": null,
      "layout": {},
      "start": 13533333,
      "style": {},
      "text": "我直接教你一个更有用的方法。",
      "trackId": "cae2256e-b7e1-4b0a-9a8b-6e306ded47b0"
    },
    {
      "end": 16996667,
      "id": "36:9b1a0337-10ca-41ee-ab22-28527c1d676136:6e7e0a49-77a5-4164-8b8c-7372548b55134573acce-4586-40cf-ab51-26d723463a73",
      "languageCode": null,
      "layout": {},
      "start": 15766667,
      "style": {},
      "text": "以后你缺什么工具，",
      "trackId": "cae2256e-b7e1-4b0a-9a8b-6e306ded47b0"
    },
    {
      "end": 19886667,
      "id": "36:9b1a0337-10ca-41ee-ab22-28527c1d676136:6e7e0a49-77a5-4164-8b8c-7372548b5513186f0be8-9f9e-4cee-a406-bb8d48f8e15f",
      "languageCode": null,
      "layout": {},
      "start": 17006667,
      "style": {},
      "text": "不需要去找别人的分享或者等别人去分享，",
      "trackId": "cae2256e-b7e1-4b0a-9a8b-6e306ded47b0"
    },
    {
      "end": 22446667,
      "id": "36:9b1a0337-10ca-41ee-ab22-28527c1d676136:da88657b-9834-4623-999c-be93374fc4b60e69b8bc-dd10-45d9-9aec-6bd0858d0ad8",
      "languageCode": null,
      "layout": {},
      "start": 20166667,
      "style": {},
      "text": "直接让 AI 去 GitHub 上面帮你找。",
      "trackId": "cae2256e-b7e1-4b0a-9a8b-6e306ded47b0"
    },
    {
      "end": 24266667,
      "id": "36:9b1a0337-10ca-41ee-ab22-28527c1d676136:2ee99286-7be3-434f-9d5b-d384306b0796e8d54011-4536-4524-bc01-be1bab3ee1d6",
      "languageCode": null,
      "layout": {},
      "start": 22666667,
      "style": {},
      "text": "比如你想找 Codex、",
      "trackId": "cae2256e-b7e1-4b0a-9a8b-6e306ded47b0"
    },
    {
      "end": 25846667,
      "id": "36:9b1a0337-10ca-41ee-ab22-28527c1d676136:2ee99286-7be3-434f-9d5b-d384306b07967c383f31-387b-4e1e-aac7-250921b11a7b",
      "languageCode": null,
      "layout": {},
      "start": 24306667,
      "style": {},
      "text": "Skill、 PPT 工具。",
      "trackId": "cae2256e-b7e1-4b0a-9a8b-6e306ded47b0"
    },
