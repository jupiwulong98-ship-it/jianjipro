      "languageCode": null,
      "layout": {},
      "start": 31300000,
      "style": {},
      "text": "先跟大家讲一下 GitHub 是什么？",
      "trackId": "cae2256e-b7e1-4b0a-9a8b-6e306ded47b0"
    },
    {
      "end": 35876667,
