    },
    {
      "id": "scene-02",
      "start": 8.7,
      "end": 18.666666666666668,
      "text": "第一个 HyperFrames。如果你要做产品介绍，画面主要是文字、图片和动画的情况下，可以看 HyperFrames。",
      "primary_intent": "claim",
      "semantic_role": "clean_explanation",
